# Local development only. Copy to .env and fill in the blank values.
# Start both frontend and API with pnpm dev.
# The API loads .env and checks configuration before entering watch mode.
# Missing or invalid required settings stop development startup.

NODE_ENV=development
PORT=3000

# Use the GitHub App Client ID, not the App ID.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Register this exact callback URL in the GitHub App settings.
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5173/api/auth/callback

# Required: 32 cryptographically random bytes encoded as 64 hex characters.
# Keep the same key across restarts; never commit the real value.
SESSION_ENCRYPTION_KEY=

# Keep the database on persistent storage.
SQLITE_DATABASE_PATH=./data/auth.sqlite

# false is allowed only for local development with a loopback callback host.
# Production requires true, NODE_ENV=production, and an HTTPS callback URL.
SESSION_COOKIE_SECURE=false
